<UserControl x:Class="NimbusX.Desktop.Views.CloudDrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NimbusX.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Connected accounts" FontWeight="SemiBold" FontSize="14.5" />
                    <TextBlock Text="{Binding ConnectNote}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,6,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisible}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add account" Style="{StaticResource PrimaryButton}" Command="{Binding AddAccountCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource RoundedScrollViewer}" Margin="0,12,0,0">
            <StackPanel>
                <Border Style="{StaticResource SubtleCard}" Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="No accounts yet" FontWeight="SemiBold" />
                        <TextBlock Text="Press 'Add account' and pick a provider. OAuth providers open their own sign-in page; MEGA, Koofr, WebDAV and SFTP ask for the credentials rclone needs. TeraBox signs in through an in-app window."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14.5" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="Experimental" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Visibility="{Binding NeedsReconnect, Converter={StaticResource BoolToVisible}}"
                                                    Background="#33D29922">
                                                <TextBlock Text="Reconnect needed" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                                            <Run Text="{Binding ProviderName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding RemoteTarget, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                            <Run Text="{Binding LastConnectedText, Mode=OneWay}" />
                                            <Run Text=" · drive letter: " />
                                            <Run Text="{Binding PreferredDriveLetterText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="{Binding QuotaText}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <controls:RingMeter Width="42" Height="42" Value="{Binding QuotaFraction}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding MountStateText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DriveLetter}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LastError}" Style="{StaticResource MutedText}"
                                               Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />

                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,14,0,0">
                                        <Button Content="{Binding MountButtonText}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.MountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsMounted, Converter={StaticResource InverseBoolToVisible}}"
                                                Margin="0,0,6,0" />
                                        <Button Content="Unmount"
                                                Style="{StaticResource BaseButton}"
                                                Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsMounted, Converter={StaticResource BoolToVisible}}"
                                                Margin="0,0,6,0" />
                                        <Button Content="Repair"
                                                Style="{StaticResource BaseButton}"
                                                Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" />
                                        <Button Content="Quota"
                                                Style="{StaticResource BaseButton}"
                                                Command="{Binding DataContext.RefreshQuotaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" />
                                        <Button Content="Open"
                                                Style="{StaticResource BaseButton}"
                                                Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsReady}"
                                                Margin="0,0,6,0" />
                                        <Button Content="&#xE712;"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Reconnect: sign in again"
                                                Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" />
                                        <Button Content="&#xE74D;"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Remove this account (nothing is deleted in the cloud)"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource SubtleCard}" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource MutedText}"
                       Text="NimbusX never deletes anything in the cloud. Removing an account only removes the encrypted rclone remote and its saved secrets from this PC." />
        </Border>
    </Grid>
</UserControl>
