<UserControl x:Class="NimbusX.Desktop.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Drive" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ComboBox Width="230"
                              ItemsSource="{Binding Mounts}"
                              SelectedItem="{Binding SelectedMount, Mode=TwoWay}"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Padding="8,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DriveLetter, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Folder inside the drive (optional)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Width="240" Style="{StaticResource InputTextBox}" Text="{Binding ScanRoot, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Leave empty to scan from the drive root, for example Games" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Measure folder sizes"
                              IsChecked="{Binding MeasureSizes}" Margin="0,0,16,0"
                              ToolTip="Off by default: measuring sizes reads every file's metadata, which is slow over the network." />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Content="Scan for games" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVisible}}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding LaunchResult}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       Visibility="{Binding LaunchResult, Converter={StaticResource TextToVisible}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            <Border Style="{StaticResource SubtleCard}" Margin="0,12,0,0"
                    BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource BodyText}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Style="{StaticResource RoundedScrollViewer}" Margin="0,12,0,0">
            <StackPanel>
                <Border Style="{StaticResource SubtleCard}" Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="The library is empty" FontWeight="SemiBold" />
                        <TextBlock Text="Mount a cloud drive, pick it above and press 'Scan for games'. NimbusX looks for executables, reads their PE headers and reports how confident it is — no guessing."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Confidence}" FontSize="10.5" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                    Background="#223FB950"
                                                    Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="verified launch" FontSize="10.5" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                            <Run Text="{Binding Folder, Mode=OneWay}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding ExecutableName, Mode=OneWay}" />
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding StartupText, StringFormat=Startup: {0}}" Style="{StaticResource MutedText}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding SizeText, StringFormat=Size: {0}}" Style="{StaticResource MutedText}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding LaunchCount, StringFormat=Launches: {0}}" Style="{StaticResource MutedText}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding LastError}" Style="{StaticResource MutedText}" Foreground="{StaticResource DangerBrush}"
                                                   Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding PlayButtonText}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVisible}}"
                                                MinWidth="76"
                                                Margin="0,0,6,0" />
                                        <Button Content="&#xE735;"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Toggle favourite"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" />
                                        <Button Content="&#xE838;"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Open the game folder"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" />
                                        <Button Content="&#xE74D;"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Remove from the library (nothing is deleted in the cloud)"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
