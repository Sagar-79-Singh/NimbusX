<Window x:Class="NimbusX.Desktop.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="NimbusX setup"
        Width="720"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Welcome to NimbusX" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Two choices and you are ready: where cached data lives and how much of the disk it may use."
                       Style="{StaticResource SubHeaderText}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">

            <StackPanel Visibility="{Binding IsFirstStep, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="1. CACHE FOLDER" Style="{StaticResource SectionText}" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Pick a folder on a local NTFS drive with at least 20 GB free. Cached data is what makes a cloud drive behave like a local one; NimbusX never touches the cloud when it clears it." />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBox Width="440" Style="{StaticResource InputTextBox}" IsReadOnly="True" Text="{Binding CacheRoot}" />
                    <Button Content="Browse…" Style="{StaticResource BaseButton}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsSecondStep, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="2. CACHE SIZE" Style="{StaticResource SectionText}" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="The budget is split evenly between mounted drives. When a drive reaches its share, rclone removes the oldest cached data — your files in the cloud are never touched." />
                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" MinWidth="92" Margin="0,0,10,0"
                                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
                                                <Setter Property="Foreground" Value="#FF06121F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding IsThirdStep, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="3. READY" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource SubtleCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="Cache folder: " />
                            <Run Text="{Binding CacheRoot, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="Budget: " />
                            <Run Text="{Binding SelectedPreset.Label, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="Next: open Cloud Drives and add your first account. NimbusX will prove the login works by reading the account before it saves anything." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border VerticalAlignment="Bottom" Style="{StaticResource SubtleCard}" BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource BodyText}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Back" Style="{StaticResource BaseButton}" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" Margin="0,0,8,0" />
                <Button Content="Finish" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
