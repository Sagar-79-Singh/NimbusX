<UserControl x:Class="NimbusX.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="15" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="#22F85149"
                                Visibility="{Binding IsHealthy, Converter={StaticResource InverseBoolToVisible}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}">
                                <Run Text="{Binding ErrorCount, Mode=OneWay}" />
                                <Run Text=" error(s), " />
                                <Run Text="{Binding WarningCount, Mode=OneWay}" />
                                <Run Text=" warning(s)" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Environment}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Re-check" Style="{StaticResource BaseButton}" Command="{Binding RefreshNowCommand}" Margin="0,0,8,0" />
                    <Button Content="Copy summary" Style="{StaticResource BaseButton}" Command="{Binding CopySummaryCommand}" Margin="0,0,8,0" />
                    <Button Content="Export bundle" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}"
                            IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBoolToVisible}}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource RoundedScrollViewer}" Margin="0,12,0,0">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DEPENDENCIES" Style="{StaticResource SectionText}" />
                        <ItemsControl ItemsSource="{Binding Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,6" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                                                    <Run Text="expected " />
                                                    <Run Text="{Binding Expected, Mode=OneWay}" />
                                                    <Run Text=", found " />
                                                    <Run Text="{Binding Installed, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="CHECKS" Style="{StaticResource SectionText}" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,6" Padding="12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Text="{Binding Area, StringFormat= · {0}}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Fix}" Style="{StaticResource MutedText}" Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,5,0,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="EXPORT" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="The bundle contains the report, the redacted settings and the newest log lines. Provider tokens, cookies and passwords are never included; rclone.conf is always excluded." />
                        <TextBox Style="{StaticResource InputTextBox}" Margin="0,10,0,0" Height="64"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Optional note for whoever reads the bundle" />
                        <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource BodyText}" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding ExportStatus, Converter={StaticResource TextToVisible}}" />
                        <TextBlock Text="{Binding ExportPath}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Margin="0,4,0,0" Visibility="{Binding ExportPath, Converter={StaticResource TextToVisible}}" />
                        <Button Content="Open export folder" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                Margin="0,6,0,0" Command="{Binding OpenExportFolderCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="LOG TAIL" Style="{StaticResource SectionText}" />
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="10">
                            <ItemsControl ItemsSource="{Binding LogTail}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
