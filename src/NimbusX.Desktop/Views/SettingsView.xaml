<UserControl x:Class="NimbusX.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource RoundedScrollViewer}">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CACHE LOCATION" Style="{StaticResource SectionText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CacheRoot}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Choose folder" Style="{StaticResource BaseButton}" Command="{Binding ChooseCacheFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="Run first run wizard" Style="{StaticResource BaseButton}" Command="{Binding RunWizardCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Cache budget" Style="{StaticResource MutedText}" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" MinWidth="76" Margin="0,0,8,0"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
                                                    <Setter Property="Foreground" Value="#FF06121F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="DRIVES AND HEALTH" Style="{StaticResource SectionText}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="First drive letter to try" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                        <ComboBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                  ItemsSource="{Binding DriveLetters}"
                                  SelectedItem="{Binding PreferredDriveLetter, Mode=TwoWay}"
                                  Background="{StaticResource SurfaceRaisedBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Padding="8,5" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Health check every (seconds)" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                        <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding HealthCheckSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Restart limit per 10 minutes" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                        <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding MaxRestarts, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Verify a launch for (seconds)" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                        <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding VerifyLaunchSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Free space kept for Windows" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                        <TextBox Grid.Column="1" Width="140" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding ProtectedFreeSpaceText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prefetch budget per session" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                        <TextBox Grid.Column="1" Width="140" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding PrefetchBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionText}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start NimbusX with Windows (current user only)"
                              IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Pause prefetch while a game is running"
                              IsChecked="{Binding GameAwareMode}" Margin="0,0,0,12" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show the experimental TeraBox provider"
                              IsChecked="{Binding ShowExperimentalTerabox}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="Data: " />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                        <Run Text="Logs: " />
                        <Run Text="{Binding LogFolder, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open data folder" Style="{StaticResource BaseButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Open log folder" Style="{StaticResource BaseButton}" Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
