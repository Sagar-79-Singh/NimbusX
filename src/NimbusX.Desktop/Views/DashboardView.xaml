<UserControl x:Class="NimbusX.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NimbusX.Desktop.Controls"
             d:DesignHeight="700" d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource RoundedScrollViewer}">
        <StackPanel>

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subheadline}" Style="{StaticResource SubHeaderText}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="{Binding AccountCount}" Style="{StaticResource MetricText}" HorizontalAlignment="Center" />
                            <TextBlock Text="accounts" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="{Binding MountedCount}" Style="{StaticResource MetricText}" HorizontalAlignment="Center" />
                            <TextBlock Text="mounted" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="{Binding GameCount}" Style="{StaticResource MetricText}" HorizontalAlignment="Center" />
                            <TextBlock Text="games" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Mount all"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding MountAllCommand}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}"
                    BorderBrush="{StaticResource DangerBrush}">
                <StackPanel>
                    <TextBlock Text="Something needs attention" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Drive tiles -->
            <TextBlock Text="YOUR DRIVES" Style="{StaticResource SectionText}" Margin="0,22,0,10" />

            <Border Style="{StaticResource SubtleCard}" Visibility="{Binding HasDrives, Converter={StaticResource InverseBoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="No cloud accounts yet" FontWeight="SemiBold" />
                    <TextBlock Text="Open Cloud Drives and add an account. NimbusX supports Google Drive, OneDrive, Dropbox, pCloud, Box, Yandex Disk, Koofr, MEGA, WebDAV, SFTP and (experimental) TeraBox."
                               Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Drives}" Visibility="{Binding HasDrives, Converter={StaticResource BoolToVisible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="304" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProviderName}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{StaticResource SurfaceHoverBrush}">
                                        <TextBlock Text="{Binding DriveLetter}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding PhaseText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                            Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="Experimental" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <controls:RingMeter Width="46" Height="46" Value="{Binding QuotaFraction}" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QuotaText}" Style="{StaticResource BodyText}" />
                                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding UsageText}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />

                                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Error}" Style="{StaticResource MutedText}" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="{Binding Fix}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="{Binding MountButtonText}"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.ToggleMountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVisible}}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Repair"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Open"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsReady}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cache + startup -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SMART CACHE" Style="{StaticResource SectionText}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CacheUsed}" Style="{StaticResource MetricText}" />
                            <TextBlock Text="{Binding CacheBudget, StringFormat= of {0}}" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        </StackPanel>
                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding CacheFraction, Mode=OneWay}"
                                     Minimum="0" Maximum="1" Margin="0,10,0,8" />
                        <TextBlock Text="{Binding CacheDetail}" Style="{StaticResource MutedText}" />
                        <Border Style="{StaticResource SubtleCard}" Margin="0,12,0,0"
                                Visibility="{Binding PrefetchPaused, Converter={StaticResource BoolToVisible}}"
                                BorderBrush="{StaticResource WarningBrush}">
                            <StackPanel>
                                <TextBlock Text="Prefetch paused" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" FontSize="12.5" />
                                <TextBlock Text="{Binding PrefetchDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PrefetchBudget, StringFormat=Prefetch budget left: {0}}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="STARTUP CHECKS" Style="{StaticResource SectionText}" />
                        <ItemsControl ItemsSource="{Binding StartupNotes}" MaxHeight="220">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Text" Value="&#xE783;" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding Fix}" Style="{StaticResource MutedText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Visibility="{Binding HasFix, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SectionText}" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
