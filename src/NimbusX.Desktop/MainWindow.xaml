<Window x:Class="NimbusX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NimbusX.Desktop.ViewModels"
        Title="NimbusX"
        Width="1280"
        Height="840"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentDeepBrush}">
                        <TextBlock Text="&#xE753;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#FF06121F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NimbusX" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version, StringFormat=version {0}}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Style="{StaticResource NavList}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15"
                                           Width="24"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Button Content="Refresh everything"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding RefreshAllCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6" />
                    <Button Content="First run wizard"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding RequestWizardCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,20,28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource HeaderText}" />
                        <TextBlock Text="{Binding SelectedPage.Subtitle}" Style="{StaticResource SubHeaderText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Margin="0,0,10,0"
                                Visibility="{Binding StartupHasProblems, Converter={StaticResource BoolToVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StartupHeadline}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Button Content="Check health"
                                Style="{StaticResource BaseButton}"
                                Command="{Binding CheckHealthCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Open data folder"
                                Style="{StaticResource BaseButton}"
                                Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" Margin="28,20,28,12" />

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="28,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding StatusHasWarning, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Text="{Binding StatusLeft}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusMiddle}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" Text="{Binding StatusRight}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
